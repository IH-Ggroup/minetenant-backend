APP_NAME="MineTenant Backend"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8787
HOST=127.0.0.1
PORT=8787

# Laravelで使っていたMySQLをそのまま利用できます。
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minetenant
DB_USERNAME=minetenant
DB_PASSWORD=minetenant

BCRYPT_ROUNDS=12
HONO_SESSION_COOKIE=minetenant_hono_session
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORE_SALE_POINTS=100

# 通常はfalse。一時公開経路の設定はREADME参照。
MINETENANT_PUBLIC_TUNNEL=false
MINETENANT_ORIGIN_TOKEN=
