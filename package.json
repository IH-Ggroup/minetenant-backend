{
  "name": "minetenant-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "lint": "eslint src scripts tests-ts",
    "format": "prettier --write src scripts tests-ts package.json package-lock.json tsconfig*.json vitest.config.ts eslint.config.js .prettierrc.json README.md docs/api.md",
    "format:check": "prettier --check src scripts tests-ts package.json package-lock.json tsconfig*.json vitest.config.ts eslint.config.js .prettierrc.json README.md docs/api.md"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "hono": "4.13.7",
    "mysql2": "3.24.4",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/validator": "13.15.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11",
    "vite": "8.1.5"
  }
}
